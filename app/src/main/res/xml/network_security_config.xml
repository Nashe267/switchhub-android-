<?xml version="1.0" encoding="utf-8"?>
<!-- Switch Hub talks to your own PC over the shop Wi-Fi or Tailscale (already encrypted), so plain http is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
